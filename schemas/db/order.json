{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "order.json",
  "title": "Order",
  "description": "An order of an account",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "The unique ID"
    },
    "accountId": {
      "type": "integer",
      "description": "The ID of the account"
    },
    "createdAt": {
      "type": "string",
      "description": "The date and time the order was created. It expects the ISO 8601 format"
    }
  },
  "required": [
    "accountId",
    "createdAt"
  ],
  "additionalProperties": false
}

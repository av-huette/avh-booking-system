{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rights.json",
  "title": "Rights",
  "description": "A permission of a role",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "The unique ID"
    },
    "roleId": {
      "type": "integer",
      "description": "The ID of the role"
    },
    "permission": {
      "type": "string",
      "description": "The permission"
    },
    "allowed": {
      "type": "boolean",
      "description": "True, if the role has the permission"
    }
  },
  "required": [
    "roleId",
    "permission",
    "allowed"
  ],
  "additionalProperties": false
}

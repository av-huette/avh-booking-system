{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "serviceSewobe.json",
  "title": "ServiceSewobe",
  "description": "The connection to a Sewobe instance",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "The unique ID"
    },
    "sewobeApiKey": {
      "type": "string",
      "description": "The API key"
    },
    "sewobeUrl": {
      "type": "string",
      "description": "The URL"
    }
  },
  "required": [
    "sewobeApiKey",
    "sewobeUrl"
  ],
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "user.json",
  "title": "User",
  "description": "A user who logs in",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "The unique ID"
    },
    "name": {
      "type": "string",
      "description": "The name"
    },
    "roleId": {
      "type": "integer",
      "description": "The ID of the role"
    },
    "password": {
      "type": "string",
      "description": "The password as the backend stores it"
    }
  },
  "required": [
    "name",
    "roleId",
    "password"
  ],
  "additionalProperties": false
}
